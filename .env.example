# Resolve Brasil — пример конфигурации.
#
#   cp .env.example .env.local
#
# .env.local игнорируется гитом. В репозиторий попадает только этот пример.

# --- Обязательно ------------------------------------------------------------

# URL проекта Supabase, вида https://<ref>.supabase.co
# Берётся в Supabase → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=

# Публичный ключ (publishable / anon). Попадает в браузер — это нормально:
# доступ к данным ограничивает RLS, а не секретность ключа.
# В новых проектах ключ выглядит как sb_publishable_..., в старых это JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Устаревшее имя того же ключа. Код читает его, если задано имя выше — нет.
# Нужно для совместимости с интеграцией Vercel ↔ Supabase, которая до сих пор
# прокидывает именно это имя.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Необязательно ----------------------------------------------------------

# Секретный ключ (secret / service_role). ОБХОДИТ RLS ЦЕЛИКОМ — это доступ ко
# всей базе. Только для серверного кода, никогда не с префиксом NEXT_PUBLIC_.
# Нужен лишь тогда, когда появятся задачи от имени сервиса (крон, вебхуки).
# SUPABASE_SECRET_KEY=

# Строка подключения к Postgres. Нужна только для миграций через Supabase CLI
# (`supabase db push`) — само приложение ходит в базу через REST, а не напрямую.
# DATABASE_URL=
