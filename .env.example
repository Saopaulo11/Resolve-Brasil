# Resolve Brasil — пример конфигурации (§78).
#
#   cp .env.example .env
#
# .env игнорируется гитом. Настоящих ключей здесь нет и быть не должно.

NODE_ENV=development
PORT=3000

# Публичный адрес стенда. Обязателен в production.
APP_URL=http://localhost:3000

# --- База данных ------------------------------------------------------------
# PostgreSQL. Prisma ходит туда напрямую — это source of truth состояния дел
# (§91, §92). Провайдер хостинга значения не имеет.
#
# На бессерверной платформе (Vercel, Lambda) нужна строка ПУЛА, а не прямого
# подключения. У Supabase прямой хост db.<ref>.supabase.co не имеет записи
# IPv4 — только IPv6, а исходящего IPv6 у функций нет. Соединение не
# начинается вовсе, и отказ выглядит как «Can't reach database server»:
# ни одной попытки входа в логах базы при этом не появляется, поэтому его
# легко принять за неверный пароль.
#
# Брать в Supabase: Connect → Transaction pooler (порт 6543). Имя
# пользователя там postgres.<ref>, а не postgres:
#
#   postgresql://postgres.<ref>:<пароль>@aws-0-<регион>.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Прямое подключение остаётся пригодным для миграций с машины разработчика.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resolve_brasil

# Либо — строка по частям. Нужна там, где её собирают в панели платформы:
# несекретные части задаются один раз и меняются раз в жизни, а при ротации
# правится только пароль. Испортить при этом хост нечем — а именно это и
# стоило больше всего времени.
#
# Работает, только если DATABASE_URL не задан. Пароль кодировать не нужно:
# спецсимволы обрабатываются при сборке.
#
#   DATABASE_HOST=aws-0-<регион>.pooler.supabase.com
#   DATABASE_PORT=6543
#   DATABASE_USER=postgres.<ref>
#   DATABASE_NAME=postgres
#   DATABASE_PARAMS=pgbouncer=true&sslmode=require
#   DATABASE_PASSWORD=<пароль базы>

# --- Сессии -----------------------------------------------------------------
# От 32 символов. Подписывает куки и солит псевдонимы в аналитике.
# Обязателен в production. Сгенерировать:  openssl rand -base64 48
SESSION_SECRET=

# Срок жизни сессии в днях. По умолчанию 30: дело тянется неделями.
# SESSION_MAX_AGE_DAYS=30

# --- AI ---------------------------------------------------------------------
# openai — основной провайдер (§6). anthropic — вторичный, для сравнения
# моделей и оценки качества (§7). mock — заглушка для разработки: она НЕ
# анализирует и ничего не выдумывает (§79).
AI_PROVIDER=mock

# ВНИМАНИЕ (§6, §41). Ключ OpenAI живёт только на сервере:
#
#   — не в браузере и не в клиентском коде;
#   — не в сборке фронтенда и не в HTML;
#   — не в гите и не в публичном репозитории;
#   — не в логах: логгер вырезает его из вывода, но в console.log
#     писать его всё равно нельзя;
#   — не в переписке и не в задачах трекера.
#
# Ключ, однажды попавший в историю гита, считается скомпрометированным
# навсегда: удаление коммита его не отзывает. Отзывает только ротация в
# консоли провайдера.
#
# В этом файле ключа нет и быть не должно — он заполняется в .env, который
# гитом игнорируется (§78).
OPENAI_API_KEY=

# Имя модели не зашито в код (§40) — задаётся здесь.
OPENAI_MODEL=

# Вторичный провайдер (§7). Те же правила обращения с ключом.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# AI_REQUEST_TIMEOUT_MS=60000
# AI_MAX_RETRIES=2
# AI_MAX_OUTPUT_TOKENS=4096

# Порог уверенности, ниже которого классификация не меняет категорию дела
# (§87). Разбор пользователю показывается в любом случае — но как
# предположение, а не как установленный факт.
# AI_CLASSIFICATION_MIN_CONFIDENCE=0.6

# Цены за миллион токенов, USD. Нужны только для учёта стоимости вызовов.
# Не заданы — стоимость не считается: придуманная цифра выглядит
# достоверной, и это хуже пустоты.
# OPENAI_PRICE_INPUT_PER_1M=
# OPENAI_PRICE_OUTPUT_PER_1M=

# Порог точности прогона оценки (§81). Нарушение запретов проваливает прогон
# при любой точности — это брак, а не статистика.
# AI_EVAL_MIN_ACCURACY=0.8

# --- Одноразовые коды (§15, §67) --------------------------------------------
# whatsapp — доставка через WhatsApp Cloud API (см. ниже).
# Пусто = mock: код печатается в лог. В production на mock код не уходит
# никуда и войти нельзя — /health показывает это отдельной строкой.
OTP_PROVIDER=
OTP_API_KEY=
# OTP_LENGTH=6
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60

# --- Уведомления и WhatsApp Cloud API (§38, §15) ----------------------------
WHATSAPP_PROVIDER=
EMAIL_PROVIDER=
EMAIL_API_KEY=

# Постоянный токен приложения из кабинета Meta. Секрет: только в переменных
# окружения, никогда в коде и не в репозитории.
WHATSAPP_API_KEY=

# Идентификатор номера отправителя (Phone number ID), оттуда же.
WHATSAPP_PHONE_NUMBER_ID=

# Версия Graph API вида v21.0. Умолчания нет намеренно: Meta заводит и
# снимает версии сама, и угаданная здесь однажды сломается молча. Значение
# видно в кабинете рядом с номером.
WHATSAPP_API_VERSION=

# Имя одобренного шаблона категории Authentication. Сообщение business-
# initiated, поэтому произвольный текст Meta не пропустит — нужен шаблон.
WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# Кнопка шаблона: url (автозаполнение), copy_code (скопировать), nenhum.
# Должна совпадать с тем, как заведён шаблон: при несовпадении числа
# параметров Meta отвергает сообщение целиком.
# WHATSAPP_OTP_BUTTON=url

# --- Хранилище документов (§25) ---------------------------------------------
# Пусто = mock: файлы на локальном диске. В production запрещено —
# документы исчезнут при перезапуске инстанса.
#
# supabase — приватный бакет Supabase Storage. Бакет обязан быть приватным:
# публичный отдаёт документы по постоянному адресу кому угодно, а документы
# пользователей не бывают публичными ни на одном шаге.
#
#   STORAGE_PROVIDER=supabase
#   STORAGE_ENDPOINT=https://<ref>.supabase.co
#   STORAGE_BUCKET=documentos
#   STORAGE_SECRET_KEY=<служебный ключ проекта (service_role)>
#
# Служебный ключ обходит политики доступа базы. Он живёт только на сервере:
# не в браузере, не в бандле, не в гите, не в логах (§6, §41).
STORAGE_PROVIDER=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# # Каталог локального хранилища заглушки. Пусто = ./storage.
# Тесты подставляют сюда временную папку и удаляют её после прогона.
# STORAGE_LOCAL_ROOT=

STORAGE_MAX_FILE_SIZE_BYTES=10485760

# Сколько файлов принимается за одну отправку формы. Предел нужен не ради
# порядка: файлы разбираются в памяти, и без потолка одна форма способна
# занять её всю.
STORAGE_MAX_FILES=10

# --- Приватность (§64) ------------------------------------------------------
# Отсрочка исполнения запроса на удаление, дни. Нужна не для удержания:
# захваченная учётная запись иначе позволяет стереть всё одним нажатием,
# и владелец узнаёт слишком поздно.
# DELETION_GRACE_DAYS=7

# --- Администрирование (§51) ------------------------------------------------
# Сессия админа живёт часами, а не месяцем, как пользовательская: её
# компрометация стоит несравнимо дороже.
# ADMIN_SESSION_MAX_AGE_HOURS=8
# ADMIN_MAX_LOGIN_FAILURES=5
# ADMIN_LOGIN_WINDOW_MINUTES=15

# --- Напоминания (§37, §38) -------------------------------------------------
# Сколько раз пытаться доставить напоминание, прежде чем отменить его.
# Без предела неудачная отправка повторялась бы на каждом запуске рассылки.
# REMINDER_MAX_ATTEMPTS=3
# REMINDER_RETRY_AFTER_MINUTES=60
# REMINDER_BATCH_SIZE=100

# --- Официальные источники (§29, §32) ---------------------------------------
# Через сколько дней проверка источника считается устаревшей. Источник,
# который никто не открывал дольше этого срока, перестаёт показываться и
# перестаёт уходить модели: процедуры и адреса меняются, а ссылка,
# поданная как подтверждённая, — это ровно то, чего §30 не допускает.
# SOURCE_MAX_AGE_DAYS=180
# SOURCE_VERIFY_TIMEOUT_MS=15000

# --- Аналитика (§57) --------------------------------------------------------
# Сегменты меньше этого размера не показываются: по трём наблюдениям
# человека можно опознать даже без телефона и имени.
ANALYTICS_MIN_GROUP_SIZE=25

# --- Сроки хранения (§65) ---------------------------------------------------
DOCUMENT_RETENTION_DAYS=365
CASE_RETENTION_DAYS=1095
AUDIT_RETENTION_DAYS=730

# --- Ограничение частоты (§46) ----------------------------------------------
# RATE_LIMIT_GLOBAL_PER_MINUTE=300
# RATE_LIMIT_AI_PER_USER_PER_HOUR=60
# RATE_LIMIT_DOCUMENTS_PER_USER_PER_DAY=50
# RATE_LIMIT_OTP_PER_PHONE_PER_HOUR=5

# --- Прочее -----------------------------------------------------------------
# Сколько доверенных прокси перед приложением. На Vercel — 1.
# TRUSTED_PROXY_HOPS=1
# LOG_LEVEL=debug
