<%
  // Отказ на нашей стороне. Рассказ человека остаётся в форме ниже: общая
  // страница ошибки его теряет, и вернуться ему некуда.
  var falhou = typeof falha !== 'undefined' && falha;
  var categoriaAtual = typeof selectedCategory !== 'undefined' ? selectedCategory : '';
%>
<%#
  Главная — рабочая область, а не витрина.

  Прежняя вёрстка ставила рассказ о продукте слева, а поле справа: человек
  читал обещания, прежде чем дойти до того, за чем пришёл. Здесь один
  столбец по центру, и первое, что он встречает, — поле «что случилось».

  Порядок в разметке тот же, что на экране: заголовок, поле, категории,
  шаги. Экранный диктор идёт по нему же.
%>
<section class="trabalho">
  <p class="trabalho__olho">Pessoas reais. Soluções reais.</p>
  <h1 class="trabalho__titulo">Conte o que aconteceu.<br />Descubra o que fazer.</h1>
  <p class="trabalho__lead">
    Conte seu problema com suas próprias palavras. A IA ajuda você a entender
    a situação, organizar as informações e encontrar os próximos passos.
  </p>

  <% if (falhou) { %>
    <%# Спокойный отказ, не большой красный блок: чинить человеку нечего. %>
    <div class="recado recado--falha" role="alert">
      <p class="recado__titulo"><%= falha.heading %></p>
      <p class="recado__texto"><%= falha.message %></p>
    </div>
  <% } %>

  <form method="post" action="/caso/novo" enctype="multipart/form-data" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="compositor">
      <label class="compositor__rotulo" for="description">O que aconteceu?</label>

      <textarea
        class="compositor__campo"
        id="description"
        name="description"
        required
        minlength="<%= descricaoMin %>"
        maxlength="<%= descricaoMax %>"
        data-cresce
        aria-describedby="description-ajuda"
        aria-invalid="<%= errors.description ? 'true' : 'false' %>"
        placeholder="Ex.: Comprei um produto pela internet, paguei via Pix e até hoje não recebi."
      ><%= values.description || '' %></textarea>

      <div class="compositor__rodape">
        <div class="compositor__anexos">
          <%- include("../partials/upload", {
                id: "arquivo",
                name: "arquivo",
                maxArquivos: maxArquivos,
                maxArquivoMb: maxArquivoMb,
                maxArquivoBytes: maxArquivoBytes,
                obrigatorio: false,
                comCamera: true,
              }) %>
        </div>

        <button type="submit" class="btn btn--primary">
          <%= falhou ? 'Tentar novamente' : 'Analisar meu caso' %>
        </button>
      </div>

      <%# Ошибка поля появляется только после отправки: требование «минимум
          20 символов» красным на пустой странице — это упрёк авансом. %>
      <p class="compositor__aviso" id="description-ajuda">
        <% if (errors.description) { %>
          <span class="compositor__aviso--erro"><%= errors.description %></span>
        <% } else { %>
          Quanto mais detalhes, melhor a IA entende o seu caso.
        <% } %>
      </p>
    </div>

    <fieldset class="categorias-rapidas">
      <legend class="categorias-rapidas__titulo">
        O que mais se parece com a sua situação?
      </legend>
      <p class="categorias-rapidas__dica">
        Opcional. Se você não escolher, a IA identifica pelo seu relato.
      </p>

      <div class="pilulas">
        <% categories.forEach(function (categoria) { %>
          <input
            type="radio"
            class="visuallyhidden"
            id="categoria-<%= categoria.slug %>"
            name="categoria"
            value="<%= categoria.slug %>"
            <%= categoriaAtual === categoria.slug ? 'checked' : '' %>
          />
          <label class="pilula" for="categoria-<%= categoria.slug %>">
            <span aria-hidden="true"><%= categoria.icon %></span>
            <%= categoria.quickLabel %>
          </label>
        <% }); %>
      </div>
    </fieldset>

    <% if (falhou) { %>
      <%# Путь назад при отказе: кнопка «повторить» — это ещё не выход. %>
      <p class="trabalho__volta">
        <a href="/">Voltar ao início</a>
      </p>
    <% } %>
  </form>
</section>

<section class="passos" aria-labelledby="como-funciona">
  <h2 class="passos__titulo" id="como-funciona">Como funciona</h2>
  <ol class="passos__lista">
    <li class="passos__item">
      <span class="passos__numero">01</span>
      <h3 class="passos__nome">Você conta o que aconteceu</h3>
      <p class="passos__texto">
        Com suas próprias palavras, sem termos jurídicos. Se tiver comprovante
        ou nota fiscal, anexe junto.
      </p>
    </li>
    <li class="passos__item">
      <span class="passos__numero">02</span>
      <h3 class="passos__nome">A IA organiza o caso</h3>
      <p class="passos__texto">
        Identifica a situação, lê os documentos e pergunta só o que ainda
        falta — no máximo cinco perguntas.
      </p>
    </li>
    <li class="passos__item">
      <span class="passos__numero">03</span>
      <h3 class="passos__nome">Você recebe os próximos passos</h3>
      <p class="passos__texto">
        Um plano de ação, as fontes oficiais quando existirem e uma mensagem
        pronta. O envio é sempre feito por você.
      </p>
    </li>
  </ol>
</section>
