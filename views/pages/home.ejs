<%
  // Отказ на нашей стороне. Рассказ человека остаётся в форме ниже: общая
  // страница ошибки его теряет, и вернуться ему некуда.
  var falhou = typeof falha !== 'undefined' && falha;
  var categoriaAtual = typeof selectedCategory !== 'undefined' ? selectedCategory : '';
%>
<section class="intake">
  <div class="container intake__grid">
    <div class="intake__lead">
      <p class="hero__tagline">Pessoas reais. Soluções reais.</p>
      <h1>Conte o que aconteceu.<br />Descubra o que fazer.</h1>
      <p class="lede">
        Conte seu problema com suas próprias palavras. A IA ajuda você a
        entender a situação, organizar as informações e encontrar os
        próximos passos.
      </p>

      <%# §14: только то, что правда. Никаких отзывов, цифр успеха и гербов
          государственных органов — ни одного из них у нас нет. %>
      <ul class="trust">
        <li>Orientação com inteligência artificial</li>
        <li>Fontes oficiais quando disponíveis</li>
        <li>Você decide o que fazer</li>
      </ul>

    </div>

    <div class="panel intake__panel">
      <% if (falhou) { %>
        <div class="flash flash--falha" role="alert">
          <strong><%= falha.heading %></strong>
          <p><%= falha.message %></p>
        </div>
      <% } %>

      <form method="post" action="/caso/novo" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="field <%= errors.description ? 'field--invalid' : '' %>">
          <label for="description">O que aconteceu?</label>
          <p class="field__hint" id="description-hint">
            Escreva como você contaria para uma pessoa: o que comprou, quando,
            quanto pagou e o que deu errado.
          </p>
          <textarea
            id="description"
            name="description"
            rows="7"
            required
            minlength="<%= descricaoMin %>"
            maxlength="<%= descricaoMax %>"
            data-contador="description-contador"
            aria-describedby="description-hint description-contador <%= errors.description ? 'description-error' : '' %>"
            aria-invalid="<%= errors.description ? 'true' : 'false' %>"
            placeholder="Ex.: Comprei um produto, paguei no Pix e até hoje não recebi."
          ><%= values.description || '' %></textarea>
          <%# Без JavaScript здесь остаётся требование словами — оно и важнее
              счётчика: человек должен понимать, чего от него ждут. %>
          <p class="field__contador" id="description-contador">
            Mínimo de <%= descricaoMin %> caracteres.
          </p>
          <% if (errors.description) { %>
            <p class="field__error" id="description-error"><%= errors.description %></p>
          <% } %>
        </div>

        <%# §5: категория необязательна. Выбор человека точнее нашего
            угадывания, но заставлять выбирать нельзя — он пришёл рассказать
            о проблеме, а не разложить её по нашим ящикам. %>
        <fieldset class="field chips">
          <legend>
            O que mais se parece com a sua situação?
            <span class="chips__opcional">opcional</span>
          </legend>
          <p class="field__hint" id="categoria-hint">
            Se você não escolher, a IA identifica pelo seu relato.
          </p>
          <div class="chips__lista">
            <% categories.forEach(function (category) { %>
              <input
                class="chips__radio"
                type="radio"
                name="categoria"
                id="categoria-<%= category.slug %>"
                value="<%= category.slug %>"
                aria-describedby="categoria-hint"
                <%= categoriaAtual === category.slug ? 'checked' : '' %>
              />
              <label class="chips__item" for="categoria-<%= category.slug %>">
                <span aria-hidden="true"><%= category.icon %></span>
                <span><%= category.quickLabel %></span>
              </label>
            <% }); %>
          </div>
        </fieldset>

        <%# §6: вложения прямо при вводе. Чек и переписка есть у человека
            сейчас, а через шаг он их приложить забудет. Работает и без
            JavaScript: браузер сам показывает, сколько файлов выбрано. %>
        <div class="field upload">
          <label for="arquivo">Tem algum documento ou comprovante?</label>
          <p class="field__hint" id="arquivo-hint">
            Nota fiscal, comprovante de Pix, pedido, conversa com a empresa.
            PDF, JPG, PNG ou WEBP — até <%= maxArquivos %> arquivos.
          </p>
          <input
            type="file"
            id="arquivo"
            name="arquivo"
            multiple
            aria-describedby="arquivo-hint"
            accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp"
          />

          <%# Отдельное поле для камеры: на телефоне оно открывает камеру, а
              не список файлов. Имя то же — сервер принимает оба как вложения. %>
          <label for="arquivo-camera" class="upload__camera">Tirar foto</label>
          <input
            type="file"
            id="arquivo-camera"
            name="arquivo"
            accept="image/*"
            capture="environment"
            aria-describedby="arquivo-hint"
          />
        </div>

        <button type="submit" class="btn btn--primary btn--block">
          <%= falhou ? 'Tentar novamente' : 'Analisar meu caso' %>
        </button>
        <% if (falhou) { %>
          <p class="small center">
            <a href="/">Voltar ao início</a>
          </p>
        <% } %>
      </form>
    </div>

      <div class="intake__passos">
        <h2>Como funciona</h2>
        <ol class="passos__lista">
          <li>
            <span class="passos__numero">1</span>
            <h3>Você conta o que aconteceu</h3>
            <p>
              Com suas próprias palavras, sem termos jurídicos. Se tiver
              comprovante, nota fiscal ou a conversa com a empresa, anexe junto.
            </p>
          </li>
          <li>
            <span class="passos__numero">2</span>
            <h3>A IA organiza o caso</h3>
            <p>
              Identifica a situação, lê os documentos que você enviou e pergunta
              só o que ainda falta — no máximo cinco perguntas.
            </p>
          </li>
          <li>
            <span class="passos__numero">3</span>
            <h3>Você recebe os próximos passos</h3>
            <p>
              Um plano de ação, as fontes oficiais quando existirem e uma
              mensagem pronta para enviar à empresa. O envio é sempre feito
              por você.
            </p>
          </li>
        </ol>
      </div>
  </div>
</section>
