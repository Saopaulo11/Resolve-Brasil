<%
  // Отказ на нашей стороне. Рассказ, категория и вложения остаются в форме:
  // общая страница ошибки их теряет, и вернуться человеку некуда.
  var falhou = typeof falha !== 'undefined' && falha;
  var categoriaAtual = typeof selectedCategory !== 'undefined' ? selectedCategory : '';
%>
<%#
  Первый экран: рабочая область.

  Порядок в разметке тот же, что на экране, — по нему же идёт экранный
  диктор: надзаголовок, заголовок, подзаголовок, поле, категории. Всё
  остальное уходит ниже сгиба: оно не должно соперничать с тем, ради чего
  человек пришёл.
%>
<section class="inicio">
  <p class="inicio__olho">Pessoas reais. Soluções reais.</p>
  <h1 class="inicio__titulo">Conte o que aconteceu.<br />Descubra o que fazer.</h1>
  <p class="inicio__lead">
    Conte seu problema com suas próprias palavras. A IA ajuda você a entender
    a situação e encontrar os próximos passos.
  </p>

  <form method="post" action="/caso/novo" enctype="multipart/form-data" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <% if (falhou) { %>
      <%# Строкой над полем, а не карточкой во весь экран: чинить человеку
          нечего, и большой красный блок здесь только пугает. %>
      <p class="aviso-inline" role="alert">
        <strong><%= falha.heading %></strong>
        <%= falha.message %>
      </p>
    <% } %>

    <div class="composer">
      <label class="composer__rotulo" for="description">O que aconteceu?</label>

      <textarea
        class="composer__campo"
        id="description"
        name="description"
        required
        minlength="<%= descricaoMin %>"
        maxlength="<%= descricaoMax %>"
        data-cresce
        aria-describedby="<%= errors.description ? 'description-erro' : '' %>"
        aria-invalid="<%= errors.description ? 'true' : 'false' %>"
        placeholder="Ex.: Comprei um produto pela internet, paguei via Pix e até hoje não recebi."
      ><%= values.description || '' %></textarea>

      <div class="composer__barra">
        <%- include("../partials/upload", {
              id: "arquivo",
              name: "arquivo",
              maxArquivos: maxArquivos,
              maxArquivoMb: maxArquivoMb,
              maxArquivoBytes: maxArquivoBytes,
              obrigatorio: false,
              comCamera: true,
            }) %>

        <button type="submit" class="btn btn--primary composer__acao">
          <%= falhou ? 'Tentar novamente' : 'Analisar meu caso' %> <span aria-hidden="true">→</span>
        </button>
      </div>

      <%# Ошибка поля — только после отправки: требование «минимум 20
          символов» красным на пустой странице это упрёк авансом. %>
      <% if (errors.description) { %>
        <p class="composer__erro" id="description-erro"><%= errors.description %></p>
      <% } %>
    </div>

    <fieldset class="chips">
      <legend class="chips__titulo">Ou escolha uma situação</legend>
      <div class="chips__lista">
        <% categories.forEach(function (categoria) { %>
          <input
            type="radio"
            class="visuallyhidden"
            id="categoria-<%= categoria.slug %>"
            name="categoria"
            value="<%= categoria.slug %>"
            <%= categoriaAtual === categoria.slug ? 'checked' : '' %>
          />
          <label class="chip" for="categoria-<%= categoria.slug %>">
            <span aria-hidden="true"><%= categoria.icon %></span>
            <%= categoria.chipLabel %>
          </label>
        <% }); %>
      </div>
    </fieldset>
  </form>
</section>

<section class="comofunciona" aria-labelledby="como-funciona">
  <h2 class="comofunciona__titulo" id="como-funciona">Como funciona</h2>
  <ol class="comofunciona__lista">
    <li>
      <span class="comofunciona__numero">01</span>
      <h3 class="comofunciona__nome">Conte</h3>
      <p class="comofunciona__texto">
        Conte o que aconteceu com suas próprias palavras.
      </p>
    </li>
    <li>
      <span class="comofunciona__numero">02</span>
      <h3 class="comofunciona__nome">Entendemos</h3>
      <p class="comofunciona__texto">
        A IA organiza as informações e identifica o que falta.
      </p>
    </li>
    <li>
      <span class="comofunciona__numero">03</span>
      <h3 class="comofunciona__nome">Próximos passos</h3>
      <p class="comofunciona__texto">
        Você recebe um plano de ação e fontes oficiais quando disponíveis.
      </p>
    </li>
  </ol>
</section>
