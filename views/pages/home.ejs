<section class="hero">
  <div class="container">
    <p class="hero__tagline">Pessoas reais. Soluções reais.</p>
    <h1>Conte o que aconteceu.<br />Descubra o que fazer.</h1>
    <p class="lede">
      Conte seu problema com suas próprias palavras. A IA vai ajudar você a
      entender a situação, organizar as informações e encontrar os próximos
      passos.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="panel">
      <%# Отказ на нашей стороне. Рассказ человека остаётся в форме ниже:
          общая страница ошибки его теряет, и вернуться ему некуда. %>
      <% var falhou = typeof falha !== 'undefined' && falha; %>
      <% if (falhou) { %>
        <div class="flash flash--falha" role="alert">
          <strong><%= falha.heading %></strong>
          <p><%= falha.message %></p>
        </div>
      <% } %>

      <form method="post" action="/caso/novo" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <%# Категория, выбранная карточкой на /categorias. Пустая — если человек
            пришёл прямо на главную: тогда категорию определит AI на PHASE 4. %>
        <input type="hidden" name="categoria"
               value="<%= typeof selectedCategory !== 'undefined' ? selectedCategory : '' %>" />

        <div class="field <%= errors.description ? 'field--invalid' : '' %>">
          <label for="description">O que aconteceu?</label>
          <p class="field__hint" id="description-hint">
            Escreva como você contaria para uma pessoa: o que comprou, quando,
            quanto pagou e o que deu errado.
          </p>
          <textarea
            id="description"
            name="description"
            rows="6"
            required
            minlength="20"
            maxlength="5000"
            aria-describedby="description-hint <%= errors.description ? 'description-error' : '' %>"
            aria-invalid="<%= errors.description ? 'true' : 'false' %>"
            placeholder="Comprei um produto, paguei no Pix e até hoje não recebi."
          ><%= values.description || '' %></textarea>
          <% if (errors.description) { %>
            <p class="field__error" id="description-error"><%= errors.description %></p>
          <% } %>
        </div>

        <%# §6: вложения прямо при вводе. Дожидаться страницы дела незачем —
            чек и переписка есть у человека уже сейчас, а через шаг он их
            приложить забудет. Работает и без JavaScript: браузер сам
            показывает, сколько файлов выбрано. %>
        <div class="field upload">
          <label for="arquivo">Tem algum documento ou comprovante?</label>
          <p class="field__hint" id="arquivo-hint">
            Nota fiscal, comprovante de Pix, pedido, conversa com a empresa.
            PDF, JPG, PNG ou WEBP — até <%= maxArquivos %> arquivos.
          </p>
          <input
            type="file"
            id="arquivo"
            name="arquivo"
            multiple
            aria-describedby="arquivo-hint"
            accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp"
          />

          <%# Отдельное поле для камеры: на телефоне оно открывает камеру, а
              не список файлов. Имя то же — сервер принимает оба как вложения. %>
          <label for="arquivo-camera" class="upload__camera">Tirar foto</label>
          <input
            type="file"
            id="arquivo-camera"
            name="arquivo"
            accept="image/*"
            capture="environment"
            aria-describedby="arquivo-hint"
          />
        </div>

        <button type="submit" class="btn btn--primary btn--block">
          <%= falhou ? 'Tentar novamente' : 'Analisar meu caso' %>
        </button>
        <% if (falhou) { %>
          <p class="small center">
            <a href="/">Voltar ao início</a>
          </p>
        <% } %>
      </form>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <h2>Ou comece por aqui</h2>
    <p class="muted small">Escolha o que mais se parece com a sua situação.</p>
    <div class="grid grid--2">
      <% categories.forEach(function (category) { %>
        <a class="category" href="/categorias/<%= category.slug %>">
          <span class="category__icon" aria-hidden="true"><%= category.icon %></span>
          <span><%= category.quickLabel %></span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <!--
      §14: только то, что правда. Никаких отзывов, цифр успеха и гербов
      государственных органов — ни одного из них у нас нет.
    -->
    <ul class="trust">
      <li>
        <span aria-hidden="true">🔒</span>
        <span>Seus dados são tratados com segurança.</span>
      </li>
      <li>
        <span aria-hidden="true">🤖</span>
        <span>Orientação com inteligência artificial.</span>
      </li>
      <li>
        <span aria-hidden="true">📚</span>
        <span>Informações baseadas em fontes oficiais quando disponíveis.</span>
      </li>
    </ul>
  </div>
</section>
