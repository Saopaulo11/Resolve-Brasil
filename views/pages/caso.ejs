<section class="section">
  <div class="container">
    <p class="case-id">Caso <strong><%= caso.publicId %></strong></p>
    <h1><%= statusLabel %></h1>
    <p class="lede"><%= statusHint %></p>

    <div class="panel">
      <h2>Resumo</h2>
      <dl class="rows">
        <div class="row">
          <dt>Empresa</dt>
          <dd><%= caso.companyName || "Ainda não informada" %></dd>
        </div>
        <div class="row">
          <dt>Valor</dt>
          <dd><%= amountFormatted || "Ainda não informado" %></dd>
        </div>
        <div class="row">
          <dt>Canal atual</dt>
          <dd><%= escalationLabel %></dd>
        </div>
      </dl>
    </div>

    <div class="panel">
      <h2>O que você contou</h2>
      <%# Текст пользователя — это USER FACT (§5), а не вывод модели. %>
      <p class="case-description"><%= caso.description %></p>
    </div>

    <h2>Linha do tempo</h2>
    <div class="panel">
      <ol class="timeline">
        <% timeline.forEach(function (event) { %>
          <li class="timeline__item">
            <time class="timeline__date" datetime="<%= event.eventDate.toISOString() %>">
              <%= event.eventDate.toLocaleDateString("pt-BR") %>
            </time>
            <div>
              <p class="timeline__title"><%= event.title %></p>
              <% if (event.description) { %>
                <p class="small muted"><%= event.description %></p>
              <% } %>
              <% if (event.source === "AI_SUGGESTION") { %>
                <p class="tag tag--ai">Sugestão da IA</p>
              <% } else if (event.source === "OFFICIAL_SOURCE") { %>
                <p class="tag tag--fonte">Fonte oficial</p>
              <% } %>
            </div>
          </li>
        <% }); %>
      </ol>
    </div>

    <h2>Análise</h2>

    <% if (aviso) { %>
      <p class="flash flash--aviso" role="status"><%= aviso %></p>
    <% } %>

    <div class="panel">
      <form method="post" action="/caso/<%= caso.publicId %>/analisar" class="actions">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" name="tipo" value="classificar" class="btn btn--primary">
          <%= classificacao ? "Analisar de novo" : "Analisar meu caso" %>
        </button>
        <button type="submit" name="tipo" value="perguntas" class="btn btn--secondary">
          O que falta saber
        </button>
        <button type="submit" name="tipo" value="plano" class="btn btn--secondary">
          Plano de ação
        </button>
        <button type="submit" name="tipo" value="rascunho" class="btn btn--secondary">
          Preparar mensagem para a empresa
        </button>
      </form>
    </div>

    <% if (classificacao) { %>
      <div class="panel">
        <h3>Entendemos sua situação</h3>
        <dl class="rows">
          <div class="row">
            <dt>Categoria</dt>
            <dd><%= classificacao.category %></dd>
          </div>
          <div class="row">
            <dt>Confiança</dt>
            <dd><%= Math.round(classificacao.confidence * 100) %>%</dd>
          </div>
        </dl>

        <% if (classificacao.missing_information.length > 0) { %>
          <h4>O que ainda falta</h4>
          <ul>
            <% classificacao.missing_information.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        <% } %>

        <% if (classificacao.risk_flags.length > 0) { %>
          <h4>Pontos de atenção</h4>
          <ul>
            <% classificacao.risk_flags.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        <% } %>

        <%- include('../partials/ai-disclaimer') %>
      </div>
    <% } %>

    <% if (perguntas && perguntas.questions.length > 0) { %>
      <div class="panel">
        <h3>Perguntas para avançar</h3>
        <ol>
          <% perguntas.questions.forEach(function (q) { %>
            <li>
              <p class="timeline__title"><%= q.question %></p>
              <p class="small muted"><%= q.why %></p>
            </li>
          <% }); %>
        </ol>
        <%- include('../partials/ai-disclaimer') %>
      </div>
    <% } %>

    <% if (plano) { %>
      <div class="panel">
        <h3>Plano de ação</h3>
        <% if (plano.steps.length > 0) { %>
          <ol>
            <% plano.steps.forEach(function (step) { %>
              <li>
                <p class="timeline__title"><%= step.title %></p>
                <p class="small"><%= step.detail %></p>
                <%# §5: видно, на чём держится шаг — на источнике или на предположении %>
                <% if (step.source === "OFFICIAL_SOURCE") { %>
                  <p class="tag tag--fonte">Fonte oficial</p>
                <% } else { %>
                  <p class="tag tag--ai">Sugestão da IA</p>
                <% } %>
              </li>
            <% }); %>
          </ol>
        <% } %>

        <% if (plano.sources.length > 0) { %>
          <h4>Fontes oficiais</h4>
          <ul>
            <% plano.sources.forEach(function (source) { %>
              <li>
                <a href="<%= source.url %>" rel="noopener noreferrer" target="_blank">
                  <%= source.organization %> — <%= source.title %>
                </a>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="notice">Não foi possível confirmar essa informação em uma fonte oficial.</p>
        <% } %>

        <% if (plano.uncertainties.length > 0) { %>
          <h4>O que não foi possível confirmar</h4>
          <ul>
            <% plano.uncertainties.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        <% } %>

        <%- include('../partials/ai-disclaimer') %>
      </div>
    <% } %>

    <% if (rascunho && rascunho.body) { %>
      <div class="panel">
        <h3>Mensagem para a empresa</h3>
        <label for="draft-subject">Assunto</label>
        <input type="text" id="draft-subject" value="<%= rascunho.subject %>" readonly />
        <label for="draft-body">Mensagem</label>
        <textarea id="draft-body" rows="12" readonly><%= rascunho.body %></textarea>
        <p>
          <button type="button" class="btn btn--secondary" data-copy="#draft-body">
            Copiar
          </button>
        </p>

        <% if (rascunho.warnings.length > 0) { %>
          <h4>Antes de enviar</h4>
          <ul>
            <% rascunho.warnings.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        <% } %>

        <p class="small muted">
          Revise o texto antes de enviar. O envio é feito por você.
        </p>

        <%- include('../partials/ai-disclaimer') %>
      </div>
    <% } %>

    <p><a href="/minha-conta#meus-casos">← Voltar para meus casos</a></p>
  </div>
</section>
