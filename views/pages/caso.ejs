<%#
  Страница дела.

  Разбор стоит сразу под шапкой: ради него человек сюда и пришёл. Сводка,
  хронология и документы — ниже; они нужны, когда дело уже ведут, а не в
  первую секунду.
%>
<section class="caso">
  <header class="caso__cabecalho">
    <%# Номер дела и дата — вторым планом: человек пришёл не за ними. Номер
        нужен, когда о деле надо с кем-то говорить, дата — чтобы понимать,
        сколько оно уже идёт. %>
    <p class="caso__numero">
      Caso <strong><%= caso.publicId %></strong>
      <span aria-hidden="true">·</span>
      <span>Criado em
        <time datetime="<%= caso.createdAt.toISOString() %>"><%= caso.createdAt.toLocaleDateString("pt-BR") %></time>
      </span>
    </p>
    <h1 class="caso__titulo">Seu caso</h1>

    <%# Категории здесь нет нарочно: она стоит крупно сразу под шапкой, и
        дважды на одном экране одно и то же — лишний шум. %>
    <div class="caso__marcas">
      <span class="marca marca--<%= statusTone %>"><%= statusLabel %></span>
      <% if (caso.companyName) { %>
        <span class="marca"><%= caso.companyName %></span>
      <% } %>
    </div>

    <p class="caso__dica"><%= statusHint %></p>
  </header>

    <% if (typeof convidado !== 'undefined' && convidado) { %>
      <%# Дело живёт в подписанной куке на полчаса. Сказать об этом нужно
          до того, как человек закроет вкладку, а не после. %>
      <div class="guardar">
        <p class="guardar__texto">
          <strong>Este caso ainda não está salvo na sua conta.</strong>
          Informe seu telefone para guardá-lo, acompanhar o andamento e
          receber lembretes. Leva menos de um minuto.
        </p>
        <a class="btn btn--primary"
           href="/entrar?next=<%= encodeURIComponent('/caso/' + caso.publicId) %>">
          Salvar meu caso
        </a>
      </div>
    <% } %>

    <%# Порядок разделов повторяет порядок решения: что за проблема → как мы
        её поняли → чего не хватает → что делать → чем написать → на чём это
        держится. Всё остальное — ниже: оно нужно реже. %>

    <% if (aviso) { %>
      <p class="flash flash--aviso" role="status"><%= aviso %></p>
    <% } %>

    <% if (falhaDaAnalise) { %>
      <%# Разбор сорвался. Не страница-заглушка во весь экран: дело цело,
          рассказ и вложения на месте, и человеку нужен один понятный шаг, а
          не сообщение о том, что всё пропало. Сам по кругу разбор не идёт —
          каждый повтор стоит денег за обращение к модели. %>
      <div class="bloco falha" role="status">
        <p class="falha__texto"><%= falhaDaAnalise %></p>
        <p class="falha__dado">Seus dados foram preservados.</p>
        <% if (progresso.next) { %>
          <form method="post" action="/caso/<%= caso.publicId %>/analisar">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="tipo" value="<%= progresso.next %>" />
            <button type="submit" class="btn btn--primary">Tentar novamente</button>
          </form>
        <% } %>
      </div>
    <% } %>

    <% if (autoAnalise) { %>
      <%# Разбор идёт сам, по шагу на запрос (§3): все четыре в один вызов
          бессерверной функции не укладываются.

          Полоса из отрезков по числу шагов, а не процент: процент пришлось бы
          выдумывать — настоящего прогресса внутри шага мы не знаем. Отрезки
          честны: столько шагов сделано из стольких.

          Форму отправляет скрипт. Без него остаётся кнопка, и человек проходит
          шаги сам, видя, какой именно следующий. %>
      <div class="bloco analise" aria-busy="true">
        <form method="post" action="/caso/<%= caso.publicId %>/analisar"
              data-auto-analise>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="tipo" value="<%= progresso.next %>" />

          <h2 class="analise__titulo">Analisando seu caso</h2>

          <p class="analise__passo" role="status" aria-live="polite">
            <span class="analise__marca" aria-hidden="true">●</span>
            <%= progresso.label %>…
          </p>

          <div class="analise__barra"
               role="img"
               aria-label="Passo <%= progresso.done + 1 %> de <%= progresso.total %>">
            <% for (let i = 0; i < progresso.total; i += 1) { %>
              <span class="<%= i < progresso.done ? 'analise__barra--feito' : '' %>"></span>
            <% } %>
          </div>

          <p class="analise__contagem">
            Passo <%= progresso.done + 1 %> de <%= progresso.total %>
          </p>

          <button type="submit" class="btn btn--primary btn--block"
                  data-auto-analise-botao>
            Continuar análise
          </button>
          <p class="small muted">
            Isso leva alguns segundos. Você pode fechar a página e voltar
            depois — o caso continua salvo.
          </p>
        </form>
      </div>
    <% } %>

    <%# ── Problema identificado ─────────────────────────────────────────
        Категория словами человека. Ни значения перечисления, ни процента
        уверенности: первое — наша константа, второе говорит о модели, а не о
        деле, но читается как измеренная величина. %>
    <% if (classificacao && classificacaoLabel) { %>
      <section class="bloco resultado resultado--principal">
        <p class="resultado__rotulo">Problema identificado</p>
        <h2 class="resultado__titulo"><%= classificacaoLabel %></h2>

        <% if (classificacaoIncerta) { %>
          <p class="resultado__ressalva">
            Ainda não é certeza: pode ser outro tipo de problema. Responda o
            que falta abaixo para confirmar.
          </p>
        <% } %>
      </section>
    <% } %>

    <%# ── O que entendemos ──────────────────────────────────────────────
        Рассказ человека — цитатой и с подписью: это его слова (§5 USER FACT),
        а не вывод модели. Пересказывать их своими словами мы не можем —
        выдумки в пересказе не отличить от факта. %>
    <section class="bloco entendemos">
      <h2>O que entendemos</h2>

      <% if (classificacao && classificacao.subcategory) { %>
        <p class="entendemos__lead"><%= classificacao.subcategory %></p>
      <% } %>

      <figure class="citacao">
        <blockquote><%= caso.description %></blockquote>
        <figcaption>Foi o que você contou.</figcaption>
      </figure>

      <% if (classificacao && classificacao.risk_flags.length > 0) { %>
        <h3 class="entendemos__sub">Pontos de atenção</h3>
        <ul class="lista">
          <% classificacao.risk_flags.forEach(function (item) { %>
            <li><%= item %></li>
          <% }); %>
        </ul>
      <% } %>

      <%- include('../partials/avaliacao', {
            mensagemId: mensagemId.classificacao,
            publicId: caso.publicId,
          }) %>
    </section>

    <%# ── O que precisamos saber ────────────────────────────────────────
        Вопросы приходят отдельным шагом. До него ответить нечем, но уже
        после опознания видно, каких сведений не хватает, — раздел не пустует
        и человек не ждёт следующего обращения к модели, чтобы понять, что от
        него нужно. Нечего показать — раздела нет вовсе. %>
    <% const faltantes = classificacao ? classificacao.missing_information : []; %>
    <% if ((perguntas && perguntas.questions.length > 0) || faltantes.length > 0) { %>
      <section class="bloco">
        <h2>O que precisamos saber</h2>
        <% if (perguntas && perguntas.questions.length > 0) { %>
          <ol class="saber">
            <% perguntas.questions.forEach(function (q) { %>
              <li>
                <p class="saber__pergunta"><%= q.question %></p>
                <p class="small muted"><%= q.why %></p>
              </li>
            <% }); %>
          </ol>
        <% } else { %>
          <ol class="saber">
            <% faltantes.forEach(function (item) { %>
              <li><p class="saber__pergunta"><%= item %></p></li>
            <% }); %>
          </ol>
        <% } %>
      </section>
    <% } %>

    <%# ── O que fazer agora ─────────────────────────────────────────────
        Главный блок страницы. Номера рисует счётчик CSS: своя цифра в
        разметке разошлась бы с порядком, стоило бы шагу пропасть. %>
    <% if (plano && plano.steps.length > 0) { %>
      <section class="bloco">
        <h2>O que fazer agora</h2>
        <ol class="passos">
          <% plano.steps.forEach(function (step) { %>
            <li>
              <p class="passos__titulo"><%= step.title %></p>
              <% if (step.detail) { %>
                <p class="passos__detalhe"><%= step.detail %></p>
              <% } %>
              <%# §5: видно, на чём держится шаг — на источнике или на догадке. %>
              <% if (step.source === "OFFICIAL_SOURCE") { %>
                <p class="tag tag--fonte">Fonte oficial</p>
              <% } else { %>
                <p class="tag tag--ai">Sugestão da IA</p>
              <% } %>
            </li>
          <% }); %>
        </ol>

        <% if (plano.uncertainties.length > 0) { %>
          <h3 class="entendemos__sub">O que não foi possível confirmar</h3>
          <ul class="lista">
            <% plano.uncertainties.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        <% } %>

        <%- include('../partials/avaliacao', {
              mensagemId: mensagemId.plano,
              publicId: caso.publicId,
            }) %>
      </section>
    <% } %>

    <%# ── Mensagem para a empresa ───────────────────────────────────────
        Письмо под раскрытием: на экране оно занимает больше места, чем всё
        остальное вместе, и, открытое сразу, отодвигает шаги, которые надо
        сделать до отправки. Раскрытие на <details> — работает без скрипта, а
        встроенные стили запрещены политикой безопасности.

        Отправляет человек сам: Resolve Brasil не пишет компаниям за него. %>
    <% if (rascunho && rascunho.body) { %>
      <details class="bloco pronta">
        <summary class="pronta__botao">
          <span>Ver mensagem pronta</span>
          <span class="pronta__seta" aria-hidden="true">→</span>
        </summary>

        <div class="pronta__corpo">
          <h2>Mensagem para a empresa</h2>

          <label for="draft-subject">Assunto</label>
          <input type="text" id="draft-subject" value="<%= rascunho.subject %>" readonly />

          <label for="draft-body">Mensagem</label>
          <textarea id="draft-body" rows="12" readonly><%= rascunho.body %></textarea>

          <p>
            <button type="button" class="btn btn--primary" data-copy="#draft-body">
              Copiar mensagem
            </button>
          </p>

          <p class="small muted">
            Mensagem gerada com base nas informações fornecidas por você.
            Revise o texto antes de enviar. O envio é feito por você.
          </p>

          <% if (rascunho.warnings.length > 0) { %>
            <h3 class="entendemos__sub">Antes de enviar</h3>
            <ul class="lista">
              <% rascunho.warnings.forEach(function (item) { %>
                <li><%= item %></li>
              <% }); %>
            </ul>
          <% } %>
        </div>
      </details>
    <% } %>

    <%# ── Fontes oficiais ───────────────────────────────────────────────
        §31: у каждой ссылки дата последней проверки — без неё она выглядит
        вечно актуальной. §32: подтверждения нет — так и сказано, ссылку мы не
        придумываем. %>
    <% if (plano) { %>
      <section class="bloco">
        <h2>Fontes oficiais</h2>
        <% if (plano.sources.length > 0) { %>
          <ul class="source-list">
            <% plano.sources.forEach(function (source) { %>
              <li class="source">
                <a href="<%= source.url %>" rel="noopener noreferrer" target="_blank">
                  <%= source.organization %> — <%= source.title %>
                </a>
                <span class="source__url"><%= source.url %></span>
                <% if (fonteVerificada[source.url]) { %>
                  <span class="small muted">
                    Verificada em <%= fonteVerificada[source.url] %>
                  </span>
                <% } %>
              </li>
            <% }); %>
          </ul>
        <% } else { %>
          <p class="small muted">
            Não foi possível confirmar uma fonte oficial relevante para este caso.
          </p>
        <% } %>
      </section>
    <% } %>

    <%# §4: дисклеймер под ответами модели — один на весь разбор, спокойным
        текстом. Повторённый под каждым блоком он превращается в шум, который
        перестают читать; ниже по странице идут уже не ответы модели, а
        документы и хронология. %>
    <% if (classificacao || plano || rascunho) { %>
      <%- include('../partials/ai-disclaimer') %>
    <% } %>

    <% if (!autoAnalise) { %>
      <%# Повторный разбор — после ответа: эти кнопки нужны тому, кого ответ
          не устроил, то есть уже прочитавшему. %>
      <div class="refazer">
        <form method="post" action="/caso/<%= caso.publicId %>/analisar" class="actions">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" name="tipo" value="classificar" class="btn btn--secondary">
            <%= classificacao ? "Analisar de novo" : "Analisar meu caso" %>
          </button>
          <button type="submit" name="tipo" value="perguntas" class="btn btn--secondary">
            O que falta saber
          </button>
          <button type="submit" name="tipo" value="plano" class="btn btn--secondary">
            Plano de ação
          </button>
          <button type="submit" name="tipo" value="rascunho" class="btn btn--secondary">
            Preparar mensagem para a empresa
          </button>
        </form>
      </div>
    <% } %>

    <div class="bloco">
      <h2 id="documentos">Documentos</h2>
      <p class="muted small">
        Nota fiscal, comprovante de Pix, pedido, conversa com a empresa.
        Aceitamos PDF, JPG, PNG e WEBP.
      </p>

      <form method="post" action="/caso/<%= caso.publicId %>/documentos"
            enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <%- include("../partials/upload", {
              id: "arquivo",
              name: "arquivo",
              titulo: "Adicionar documento",
              dica: "Você pode escolher vários de uma vez.",
              maxArquivos: maxArquivos,
              maxArquivoMb: maxArquivoMb,
              maxArquivoBytes: maxArquivoBytes,
              obrigatorio: true,
              comCamera: true,
            }) %>

        <div class="field">
          <label for="tipo-documento">O que é este arquivo?</label>
          <select id="tipo-documento" name="tipo">
            <option value="COMPROVANTE_PIX">Comprovante de Pix</option>
            <option value="NOTA_FISCAL">Nota fiscal</option>
            <option value="PEDIDO">Pedido</option>
            <option value="CONVERSA">Conversa</option>
            <option value="EMAIL">E-mail</option>
            <option value="RESPOSTA_DA_EMPRESA">Resposta da empresa</option>
            <option value="CONTRATO">Contrato</option>
            <option value="CAPTURA_DE_TELA">Captura de tela</option>
            <option value="OUTRO" selected>Outro</option>
          </select>
        </div>

        <button type="submit" class="btn btn--primary">Enviar documentos</button>
      </form>

      <% if (documentos.length > 0) { %>
        <ul class="doc-list">
          <% documentos.forEach(function (doc) { %>
            <li class="doc">
              <div class="doc__info">
                <a href="/caso/<%= caso.publicId %>/documentos/<%= doc.id %>">
                  <%= doc.filename %>
                </a>
                <p class="small muted">
                  <%= doc.kindLabel %> · <%= doc.sizeKb %> KB · <%= doc.createdAt %>
                </p>
              </div>
              <%# Извлечение — отдельное действие: это единственная операция,
                  где сам файл уходит провайдеру модели (§47, §48). %>
              <div class="doc__acoes">
                <% if (doc.extractionStatus === "CONCLUIDA") { %>
                  <span class="tag tag--concluido">Lido</span>
                <% } else { %>
                  <form method="post"
                        action="/caso/<%= caso.publicId %>/documentos/<%= doc.id %>/extrair">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn--secondary">
                      Ler dados do documento
                    </button>
                  </form>
                <% } %>

                <%# Приложить не то легко — с телефона особенно. Без способа
                    убрать файл человек либо бросает дело, либо оставляет в нём
                    чужой документ (§21). %>
                <form method="post"
                      action="/caso/<%= caso.publicId %>/documentos/<%= doc.id %>/remover">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn--link"
                          aria-label="Remover <%= doc.filename %>">
                    Remover
                  </button>
                </form>
              </div>
            </li>
          <% }); %>
        </ul>
        <p class="small muted">
          Seus documentos são privados. Eles não têm link público e só são
          enviados para leitura automática quando você pede.
        </p>
      <% } %>
    </div>

    <div class="bloco">
      <h2 id="historico">Histórico do caso</h2>
      <ol class="timeline">
        <% timeline.forEach(function (event) { %>
          <li class="timeline__item">
            <time class="timeline__date" datetime="<%= event.eventDate.toISOString() %>">
              <%= event.eventDate.toLocaleDateString("pt-BR") %>
            </time>
            <div>
              <p class="timeline__title"><%= event.title %></p>
              <% if (event.description) { %>
                <p class="small muted"><%= event.description %></p>
              <% } %>
              <% if (event.source === "AI_SUGGESTION") { %>
                <p class="tag tag--ai">Sugestão da IA</p>
              <% } else if (event.source === "OFFICIAL_SOURCE") { %>
                <p class="tag tag--fonte">Fonte oficial</p>
              <% } %>
            </div>
          </li>
        <% }); %>
      </ol>
    </div>

    <div class="bloco">
      <h2>Resumo</h2>
      <dl class="rows">
        <div class="row">
          <dt>Empresa</dt>
          <dd><%= caso.companyName || "Ainda não informada" %></dd>
        </div>
        <div class="row">
          <dt>Valor</dt>
          <dd><%= amountFormatted || "Ainda não informado" %></dd>
        </div>
        <div class="row">
          <dt>Canal atual</dt>
          <dd><%= escalationLabel %></dd>
        </div>
        <div class="row">
          <dt>Estado</dt>
          <dd><%= estadoNome || "Não informado" %></dd>
        </div>
      </dl>
    </div>

    <div class="bloco">
      <h3>Seu estado</h3>
      <%# §57: спрашивается только штат. Procon у каждого штата свой, и без
          него «куда идти» ответить нельзя. Города нет и не будет: вместе с
          суммой и категорией он опознаёт человека не хуже имени (§55). %>
      <p class="muted small">
        O Procon é estadual, então o estado muda para onde o caso pode ir.
        Não perguntamos sua cidade nem seu endereço.
      </p>

      <form method="post" action="/caso/<%= caso.publicId %>/estado">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="field">
          <label for="estado">Estado</label>
          <select id="estado" name="estado">
            <option value="">Prefiro não informar</option>
            <% estados.forEach(function (estado) { %>
              <option value="<%= estado.uf %>" <%= estadoAtual === estado.uf ? "selected" : "" %>>
                <%= estado.name %>
              </option>
            <% }); %>
          </select>
        </div>

        <button type="submit" class="btn btn--secondary">Salvar estado</button>
      </form>
    </div>

    <% if (pix) { %>
      <h2 id="pix">Sobre o Pix</h2>
      <div class="bloco">
        <%# §36: мошенничество, платёж не тем и спор с реальной компанией
            ведут в разные стороны. Различить их по рассказу нельзя, поэтому
            выбирает человек, а не система (§5). %>
        <p class="muted small">
          Pix tem caminhos diferentes dependendo do que aconteceu. Qual das
          situações abaixo descreve melhor o seu caso?
        </p>

        <% if (pix.atualLabel) { %>
          <p><strong>Situação informada:</strong> <%= pix.atualLabel %></p>
        <% } %>

        <form method="post" action="/caso/<%= caso.publicId %>/pix">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <fieldset class="choices">
            <legend class="sr-only">Situação do Pix</legend>
            <% pix.opcoes.forEach(function (opcao) { %>
              <div class="choice">
                <input type="radio" id="pix-<%= opcao.value %>" name="situacao"
                       value="<%= opcao.value %>"
                       <%= pix.atual === opcao.value ? "checked" : "" %> />
                <label for="pix-<%= opcao.value %>">
                  <span class="choice__label"><%= opcao.label %></span>
                  <span class="choice__hint"><%= opcao.hint %></span>
                </label>
              </div>
            <% }); %>
          </fieldset>

          <button type="submit" class="btn btn--primary">Salvar situação</button>
        </form>

        <%# §9: конкретные процедуры и сроки сюда не вписываются — они
            меняются и обязаны приходить из проверенного источника. %>
        <p class="small muted">
          Essa informação entra no seu caso como um fato seu e orienta as
          próximas sugestões. Prazos e procedimentos aparecem apenas quando
          houver uma fonte oficial confirmada para eles.
        </p>
      </div>
    <% } %>

    <% if (fatos.length > 0) { %>
      <h2 id="dados-extraidos">Dados encontrados nos documentos</h2>
      <div class="bloco">
        <p class="muted small">
          Estes dados foram lidos automaticamente e <strong>ainda não são
          fatos do caso</strong>. Confirme, corrija ou descarte cada um.
        </p>

        <ul class="fact-list">
          <% fatos.forEach(function (fato) { %>
            <li class="fact">
              <div class="fact__head">
                <span class="fact__label"><%= fato.label %></span>
                <span class="tag tag--<%= fato.statusTone %>"><%= fato.statusLabel %></span>
              </div>

              <% if (fato.status === "UNCONFIRMED") { %>
                <form method="post"
                      action="/caso/<%= caso.publicId %>/fatos/<%= fato.id %>"
                      class="fact__form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <label class="sr-only" for="valor-<%= fato.id %>">
                    <%= fato.label %>
                  </label>
                  <input type="text" id="valor-<%= fato.id %>" name="valor"
                         value="<%= fato.value %>" maxlength="500" />
                  <div class="actions">
                    <button type="submit" name="decisao" value="confirmar"
                            class="btn btn--primary">Confirmar</button>
                    <button type="submit" name="decisao" value="corrigir"
                            class="btn btn--secondary">Salvar correção</button>
                    <button type="submit" name="decisao" value="rejeitar"
                            class="btn btn--secondary">Descartar</button>
                  </div>
                  <% if (fato.confidence !== null) { %>
                    <p class="small muted">
                      Confiança da leitura: <%= fato.confidence %>%
                    </p>
                  <% } %>
                </form>
              <% } else { %>
                <p class="fact__value"><%= fato.value %></p>
              <% } %>
            </li>
          <% }); %>
        </ul>

        <%- include('../partials/ai-disclaimer') %>
      </div>
    <% } %>


    <h2 id="lembretes">Lembretes</h2>

    <div class="bloco">
      <p class="muted small">
        Prazos de empresa passam despercebidos. Marque quando quer ser
        lembrado de voltar a este caso.
      </p>

      <form method="post" action="/caso/<%= caso.publicId %>/lembretes">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="field">
          <label for="titulo-lembrete">Lembrar de</label>
          <input type="text" id="titulo-lembrete" name="titulo" maxlength="120"
                 value="Verificar a resposta da empresa" />
        </div>

        <div class="field">
          <label for="prazo">Quando</label>
          <select id="prazo" name="prazo">
            <% presets.forEach(function (preset) { %>
              <option value="<%= preset.value %>"><%= preset.label %></option>
            <% }); %>
            <option value="custom">Escolher uma data</option>
          </select>
        </div>

        <div class="field">
          <label for="data-lembrete">Data específica</label>
          <p class="field__hint">
            Usada apenas se você escolher «Escolher uma data» acima.
          </p>
          <input type="date" id="data-lembrete" name="data" />
        </div>

        <button type="submit" class="btn btn--primary">Criar lembrete</button>
      </form>

      <% if (lembretes.length > 0) { %>
        <ul class="reminder-list">
          <% lembretes.forEach(function (lembrete) { %>
            <li class="reminder">
              <div>
                <p class="timeline__title"><%= lembrete.title %></p>
                <p class="small muted"><%= lembrete.scheduledAt %></p>
              </div>
              <% if (lembrete.pendente) { %>
                <form method="post"
                      action="/caso/<%= caso.publicId %>/lembretes/<%= lembrete.id %>/cancelar">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <button type="submit" class="btn btn--secondary">Cancelar</button>
                </form>
              <% } else if (lembrete.status === "ENVIADO") { %>
                <span class="tag tag--concluido">Enviado</span>
              <% } else { %>
                <span class="tag tag--neutro">Cancelado</span>
              <% } %>
            </li>
          <% }); %>
        </ul>
        <p class="small muted">
          Lembretes são avisos sobre o seu caso, não propaganda. Eles não
          dependem da sua opção de receber novidades.
        </p>
      <% } %>
    </div>

    <h2 id="resposta">Recebi uma resposta</h2>

    <div class="bloco">
      <p class="muted small">
        A empresa respondeu? Cole o texto ou envie o print, o e-mail ou o PDF.
        Vamos mostrar o que foi dito, o que ficou sem resposta e o que dá para
        fazer em seguida.
      </p>

      <form method="post" action="/caso/<%= caso.publicId %>/resposta"
            enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="field">
          <label for="texto-resposta">Texto da resposta</label>
          <textarea id="texto-resposta" name="texto" rows="6"
                    maxlength="20000"
                    placeholder="Cole aqui o que a empresa respondeu."></textarea>
        </div>

        <div class="field">
          <label for="arquivo-resposta">Ou envie um arquivo</label>
          <p class="field__hint">Print da conversa, e-mail em PDF, foto da carta.</p>
          <input type="file" id="arquivo-resposta" name="arquivo"
                 accept=".pdf,.jpg,.jpeg,.png,.webp" />
        </div>

        <button type="submit" class="btn btn--primary">Analisar resposta</button>
      </form>
    </div>

    <% if (analiseResposta) { %>
      <div class="bloco">
        <h3>O que a empresa respondeu</h3>
        <p><%= analiseResposta.what_company_said %></p>

        <h4>O que isso significa</h4>
        <p><%= analiseResposta.what_it_means %></p>

        <% if (analiseResposta.what_is_missing.length > 0) { %>
          <h4>O que ainda não foi respondido</h4>
          <ul>
            <% analiseResposta.what_is_missing.forEach(function (item) { %>
              <li><%= item %></li>
            <% }); %>
          </ul>
        <% } %>

        <% if (analiseResposta.possible_next_action) { %>
          <h4>Próxima ação possível</h4>
          <p><%= analiseResposta.possible_next_action %></p>
          <%# §3: это предположение, а не обязанность компании и не гарантия. %>
          <p class="tag tag--ai">Sugestão da IA</p>
        <% } %>

        <% if (analiseResposta.suggested_reply) { %>
          <h4>Resposta sugerida</h4>
          <label class="sr-only" for="reply-body">Resposta sugerida</label>
          <textarea id="reply-body" rows="8" readonly><%= analiseResposta.suggested_reply %></textarea>
          <p>
            <button type="button" class="btn btn--secondary" data-copy="#reply-body">
              Copiar
            </button>
          </p>
          <p class="small muted">
            Revise antes de enviar. O envio é feito por você.
          </p>
        <% } %>

        <%- include('../partials/ai-disclaimer') %>
        <%- include('../partials/avaliacao', {
              mensagemId: mensagemId.analiseResposta,
              publicId: caso.publicId,
            }) %>
      </div>
    <% } %>

    <h2 id="desfecho">Como está o caso</h2>

    <% if (encerrado) { %>
      <div class="bloco">
        <p>Este caso está encerrado.</p>
        <%# Закрыл по ошибке или проблема вернулась — дело возвращается в
            работу, а не заводится заново: история нужна целиком. %>
        <p class="muted small">
          Se o problema voltou, ou se você encerrou sem querer, dá para
          retomar de onde parou.
        </p>
        <form method="post" action="/caso/<%= caso.publicId %>/reabrir">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn--secondary">Reabrir caso</button>
        </form>
      </div>
    <% } else { %>
      <div class="bloco">
        <h3>Levei o caso para outro canal</h3>
        <%# §3: обращается человек. Мы не подаём жалобу за него и не
            представляем его — только записываем то, что он сделал сам. %>
        <p class="muted small">
          Quem registra a reclamação é você. Aqui a gente apenas anota para
          onde o caso foi, para acompanhar o prazo e o que veio depois.
        </p>

        <form method="post" action="/caso/<%= caso.publicId %>/escalar">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

          <div class="field">
            <label for="canal">Canal</label>
            <select id="canal" name="canal">
              <% canais.forEach(function (canal) { %>
                <option value="<%= canal.valor %>" <%= canal.sugerido ? "selected" : "" %>>
                  <%= canal.rotulo %><%= canal.atual ? " (canal atual)" : "" %>
                </option>
              <% }); %>
            </select>
          </div>

          <button type="submit" class="btn btn--secondary">Registrar canal</button>
        </form>
      </div>

      <div class="bloco">
        <h3>Encerrar o caso</h3>
        <%# §19: два исхода, и оба честные. Свести их к одному значило бы
            считать каждое брошенное дело успехом. %>
        <p class="muted small">
          Marque como resolvido só se o problema foi realmente resolvido.
          Encerrar sem solução também é uma resposta — e é assim que ela
          aparece nos números.
        </p>

        <form method="post" action="/caso/<%= caso.publicId %>/encerrar" class="actions">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" name="desfecho" value="resolvido" class="btn btn--primary">
            Foi resolvido
          </button>
          <button type="submit" name="desfecho" value="encerrado" class="btn btn--secondary">
            Encerrar sem solução
          </button>
        </form>
      </div>
    <% } %>

    <p><a href="/minha-conta#meus-casos">← Voltar para meus casos</a></p>
  </section>
