<section class="section">
  <div class="container">
    <h1>Minha conta</h1>

    <% if (saved) { %>
      <p class="flash" role="status">Preferências salvas.</p>
    <% } %>

    <h2 id="meus-casos">Meus casos</h2>
    <div class="panel">
      <% if (cases.length === 0) { %>
        <p class="muted">Você ainda não tem casos.</p>
        <a class="btn btn--primary" href="/">Contar o que aconteceu</a>
      <% } else { %>
        <ul class="case-list">
          <% cases.forEach(function (item) { %>
            <li class="case-card">
              <a class="case-card__link" href="/caso/<%= item.publicId %>">
                <span class="case-card__title"><%= item.categoryLabel %></span>
              </a>
              <dl class="rows">
                <div class="row">
                  <dt>Empresa</dt>
                  <dd><%= item.companyName || "Ainda não informada" %></dd>
                </div>
                <div class="row">
                  <dt>Valor</dt>
                  <dd><%= item.amountFormatted || "Ainda não informado" %></dd>
                </div>
                <div class="row">
                  <dt>Status</dt>
                  <dd>
                    <span class="tag tag--<%= item.statusTone %>"><%= item.statusLabel %></span>
                  </dd>
                </div>
                <div class="row">
                  <dt>Última atualização</dt>
                  <dd><%= item.updatedAt %></dd>
                </div>
              </dl>
            </li>
          <% }); %>
        </ul>
        <a class="btn btn--secondary" href="/">Contar outro caso</a>
      <% } %>
    </div>

    <h2 id="meus-dados">Meus dados</h2>
    <div class="panel">
      <dl class="rows">
        <div class="row">
          <dt>Telefone</dt>
          <dd><%= phoneMasked %></dd>
        </div>
        <div class="row">
          <dt>Conta criada em</dt>
          <dd><%= memberSince %></dd>
        </div>
      </dl>
      <p class="small muted">
        Não pedimos CPF, endereço nem dados bancários para criar sua conta.
      </p>
    </div>

    <h2 id="notificacoes">Notificações</h2>
    <div class="panel">
      <form method="post" action="/minha-conta/notificacoes">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

        <div class="field field--check">
          <input
            type="checkbox"
            id="case-notifications"
            checked
            disabled
          />
          <label for="case-notifications" class="label--inline">
            Avisos sobre os meus casos
          </label>
        </div>
        <p class="field__hint">
          Avisos sobre o andamento do seu caso são parte do serviço e não podem
          ser desativados aqui.
        </p>

        <div class="field field--check">
          <input
            type="checkbox"
            id="marketing"
            name="marketing"
            <%= marketingConsent ? 'checked' : '' %>
          />
          <label for="marketing" class="label--inline"><%= marketingLabel %></label>
        </div>

        <button type="submit" class="btn btn--primary">Salvar</button>
      </form>
    </div>

    <h2 id="privacidade">Privacidade</h2>
    <div class="panel">
      <p>
        Veja o que coletamos e quais são seus direitos na
        <a href="/privacidade">Política de privacidade</a>.
      </p>
      <p>
        No <a href="/minha-conta/privacidade">centro de privacidade</a> você
        baixa seus dados e pode pedir a exclusão da conta.
      </p>
    </div>

    <h2 id="sair">Sair</h2>
    <div class="panel">
      <form method="post" action="/sair">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button type="submit" class="btn btn--secondary">Sair da conta</button>
      </form>
    </div>
  </div>
</section>
