<section class="pagina">
  <h1 class="pagina__titulo">Categorias</h1>
  <p class="pagina__lead">
    Estas são as situações atendidas nesta primeira versão. Se a sua não
    estiver aqui, escolha <strong>Outro problema</strong> e conte com suas
    palavras.
  </p>

  <%# Вся карточка — ссылка: попасть по ней проще, чем по кнопке внутри,
      особенно пальцем. %>
  <div class="cartoes">
    <% categories.forEach(function (category) { %>
      <a class="cartao-item" href="/?categoria=<%= category.slug %>">
        <span aria-hidden="true"><%= category.icon %></span>
        <h2 class="cartao-item__nome"><%= category.label %></h2>
        <p class="cartao-item__texto"><%= category.description %></p>
      </a>
    <% }); %>
  </div>
</section>
