<%#
  Вложения (§6, §25).

  Локали: id, name, maxArquivos, maxArquivoMb, maxArquivoBytes,
  obrigatorio (bool), comCamera (bool).

  Без JavaScript видны обычные поля выбора файла: браузер сам показывает,
  что выбрано, и форма отправляется полностью. Скрипт ставит блоку признак
  upload--pronto — только тогда появляются кнопки и список, а поля прячутся.
  Порядок именно такой: не выполнится скрипт — останется рабочее поле, а не
  кнопка, которая ничего не открывает.
%>
<div class="upload"
     data-upload
     data-upload-max="<%= maxArquivos %>"
     data-upload-bytes="<%= maxArquivoBytes %>">

  <%# Список идёт раньше кнопок: добавленный файл появляется над ними, а не
      выталкивает их вниз. aria-live проговаривает добавление. %>
  <ul class="upload__lista" data-upload-lista role="status" aria-live="polite"></ul>

  <div class="upload__zona" data-upload-zona>
    <div class="upload__acoes">
      <label class="btn--discreto" for="<%= id %>">
        <span aria-hidden="true">＋</span> Adicionar documento
      </label>
      <% if (comCamera) { %>
        <label class="btn--discreto upload__camera" for="<%= id %>-camera">
          <span aria-hidden="true">📷</span> Tirar foto
        </label>
      <% } %>
    </div>

    <%# Перетаскивание работает — значит о нём надо сказать. На узком экране
        подпись скрыта стилями: там не перетаскивают. %>
    <p class="upload__arrastar">Arraste o arquivo aqui ou escolha do dispositivo</p>

    <p class="upload__formatos" id="<%= id %>-hint">
      PDF, JPG, PNG ou WEBP · até <%= maxArquivoMb %> MB · até <%= maxArquivos %> arquivos
    </p>

    <input
      type="file"
      class="upload__entrada"
      id="<%= id %>"
      name="<%= name %>"
      multiple
      <%= obrigatorio ? 'required' : '' %>
      data-upload-entrada
      aria-describedby="<%= id %>-hint"
      accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp"
    />

    <% if (comCamera) { %>
      <%# Отдельное поле для камеры: на телефоне оно открывает камеру, а не
          список файлов. Имя то же — сервер принимает оба как вложения. %>
      <input
        type="file"
        class="upload__entrada upload__entrada--camera"
        id="<%= id %>-camera"
        name="<%= name %>"
        accept="image/*"
        capture="environment"
        data-upload-camera
        aria-describedby="<%= id %>-hint"
      />
    <% } %>
  </div>
</div>
