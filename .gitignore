# Зависимости
/node_modules

# Сборка
/dist
*.tsbuildinfo

# Клиент Prisma генерируется из prisma/schema.prisma (npm run db:generate).
# В репозитории ему не место: версия в дереве разъедется со схемой.
/src/generated/

# Переменные окружения. В .env лежат SESSION_SECRET и ключи провайдеров —
# они не должны попасть в репозиторий ни при каких условиях (§6, §41, §78).
#
# Ключ OpenAI живёт только на сервере: не в браузере, не в бандле, не в
# гите. Попавший в историю ключ считается скомпрометированным навсегда —
# удаление коммита его не отзывает, отзывает только ротация в консоли
# провайдера.
.env
.env.*
!.env.example
# Файлы вида production.env, staging.env — .env.* их не ловит.
*.env

# Ключи и сертификаты в любом виде.
*.pem
*.key
*.p12
*.pfx
secrets.json

# Загруженные файлы локального стенда: это документы пользователей.
/storage/
/uploads/

# Прочее
.DS_Store
.vercel
coverage/

# Логи
npm-debug.log*
yarn-debug.log*
*.log
