# Зависимости
/node_modules
/.pnp
.pnp.*

# Сборка Next.js
/.next/
/out/
/build

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Переменные окружения. Ключи Supabase не должны попадать в репозиторий:
# publishable-ключ ещё можно показать браузеру, secret-ключ обходит RLS и
# равнозначен полному доступу к базе.
.env
.env.*
!.env.example

# Локальный стек Supabase CLI
/supabase/.branches
/supabase/.temp

# Прочее
.DS_Store
*.pem
.vercel

# Логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
